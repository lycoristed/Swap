local Players = game:GetService("Players")
local lp = Players.LocalPlayer

-- 1. THE SIGNAL SYSTEM (The 'Replication' bridge)
-- We use a StringValue in the Player folder. It's visible to all clients.
local function createBridge()
    local folder = lp:FindFirstChild("ReplicationBridge") or Instance.new("Folder", lp)
    folder.Name = "ReplicationBridge"
    
    local swapSignal = folder:FindFirstChild("SwapEvent") or Instance.new("StringValue", folder)
    swapSignal.Name = "SwapEvent"
    swapSignal.Value = ""
end
createBridge()

-- 2. THE UI (Minimalist version to prevent 'Black Screen' issues)
local sg = Instance.new("ScreenGui", lp:WaitForChild("PlayerGui"))
local frame = Instance.new("Frame", sg)
frame.Size = UDim2.new(0, 180, 0, 200)
frame.Position = UDim2.new(0.4, 0, 0.4, 0)
frame.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
frame.Active = true
frame.Draggable = true

local title = Instance.new("TextLabel", frame)
title.Size = UDim2.new(1, 0, 0, 30)
title.Text = "Sync Swapper"
title.TextColor3 = Color3.new(1, 1, 1)
title.BackgroundColor3 = Color3.fromRGB(20, 20, 20)

local target = nil

-- 3. THE REPLICATION LOGIC
local function performLocalTeleport(pos)
    if lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
        lp.Character.HumanoidRootPart.CFrame = pos
    end
end

-- This listens for your friend's signal
local function connectToPartner(partner)
    local bridge = partner:WaitForChild("ReplicationBridge", 10)
    if bridge then
        bridge.SwapEvent.Changed:Connect(function(val)
            if val ~= "" and lp.Character and partner.Character then
                -- YOUR script hears HIS signal and moves YOU to HIM
                local hisPos = partner.Character.HumanoidRootPart.CFrame
                performLocalTeleport(hisPos)
                print("Replicated swap from partner")
            end
        end)
    end
end

-- 4. BUTTONS
local function makeButtons()
    local yOffset = 35
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= lp then
            local b = Instance.new("TextButton", frame)
            b.Size = UDim2.new(0.9, 0, 0, 25)
            b.Position = UDim2.new(0.05, 0, 0, yOffset)
            b.Text = p.Name
            b.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
            b.TextColor3 = Color3.new(1, 1, 1)

            b.MouseButton1Click:Connect(function()
                target = p
                connectToPartner(p)
                
                -- Clear UI and show the Swap button
                for _, child in pairs(frame:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end
                
                local sBtn = Instance.new("TextButton", frame)
                sBtn.Size = UDim2.new(0.9, 0, 0, 60)
                sBtn.Position = UDim2.new(0.05, 0, 0, 50)
                sBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 0)
                sBtn.Text = "SWAP PLACES"
                sBtn.TextColor3 = Color3.new(1, 1, 1)

                sBtn.MouseButton1Click:Connect(function()
                    if target and target.Character then
                        local myBridge = lp.ReplicationBridge.SwapEvent
                        local targetPos = target.Character.HumanoidRootPart.CFrame
                        
                        -- 1. Move yourself
                        performLocalTeleport(targetPos)
                        
                        -- 2. Signal him to move (This is the 'replication')
                        myBridge.Value = tostring(math.random(1, 100000)) 
                    end
                end)
            end)
            yOffset = yOffset + 30
        end
    end
end

makeButtons()
