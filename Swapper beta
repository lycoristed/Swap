-- Settings
local TAG_NAME = "SyncActive_Token"
local REQUEST_TAG = "SwapRequest" 

-- 1. Setup Tags
local lp = game.Players.LocalPlayer
local function setupTags(char)
    if not char then return end
    if not char:FindFirstChild(TAG_NAME) then
        Instance.new("StringValue", char).Name = TAG_NAME
    end
    local req = char:FindFirstChild(REQUEST_TAG) or Instance.new("StringValue", char)
    req.Name = REQUEST_TAG
    req.Value = ""
end
setupTags(lp.Character or lp.CharacterAdded:Wait())
lp.CharacterAdded:Connect(setupTags)

-- 2. UI Setup
local screenGui = Instance.new("ScreenGui", game:GetService("CoreGui"))
local mainFrame = Instance.new("Frame", screenGui)
mainFrame.Size = UDim2.new(0, 150, 0, 200)
mainFrame.Position = UDim2.new(0.05, 0, 0.4, 0)
mainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
mainFrame.Active = true
mainFrame.Draggable = true
Instance.new("UICorner", mainFrame)

local scroll = Instance.new("ScrollingFrame", mainFrame)
scroll.Size = UDim2.new(1, -10, 1, -40)
scroll.Position = UDim2.new(0, 5, 0, 35)
scroll.BackgroundTransparency = 1
scroll.CanvasSize = UDim2.new(0,0,0,0)

local swapBtn = Instance.new("TextButton", mainFrame)
swapBtn.Size = UDim2.new(1, -10, 1, -40)
swapBtn.Position = UDim2.new(0, 5, 0, 35)
swapBtn.Text = "SWAP"
swapBtn.Visible = false
Instance.new("UICorner", swapBtn)

-- 3. The Logic
local targetPlayer = nil

-- The Actual Movement Function
local function executeMove()
    if targetPlayer and targetPlayer.Character and lp.Character then
        local myRoot = lp.Character:FindFirstChild("HumanoidRootPart")
        local hisRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        if myRoot and hisRoot then
            myRoot.CFrame = hisRoot.CFrame
        end
    end
end

-- Watch for his request
local function watchTarget(p)
    if p.Character then
        local req = p.Character:WaitForChild(REQUEST_TAG, 5)
        if req then
            req.Changed:Connect(function(val)
                if val == "Trigger" then
                    executeMove()
                    task.wait(0.5)
                    -- Reset local value so we don't loop
                end
            end)
        end
    end
end

-- Clicking the Button
swapBtn.MouseButton1Click:Connect(function()
    local myReq = lp.Character:FindFirstChild(REQUEST_TAG)
    if myReq then
        executeMove() -- I move myself
        myReq.Value = "Trigger" -- This signal tells HIS script to move him
        task.wait(0.1)
        myReq.Value = "" -- Reset
    end
end)

local function updateList()
    for _, v in pairs(scroll:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    for _, p in pairs(game.Players:GetPlayers()) do
        if p ~= lp and p.Character and p.Character:FindFirstChild(TAG_NAME) then
            local btn = Instance.new("TextButton", scroll)
            btn.Size = UDim2.new(1, 0, 0, 30)
            btn.Text = p.DisplayName
            btn.MouseButton1Click:Connect(function()
                targetPlayer = p
                scroll.Visible = false
                swapBtn.Visible = true
                mainFrame.Size = UDim2.new(0, 100, 0, 80)
                watchTarget(p) -- Start listening for his clicks
            end)
        end
    end
end

-- Refresh loop
spawn(function()
    while task.wait(2) do if scroll.Visible then updateList() end end
end)

