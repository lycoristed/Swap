local Players = game:GetService("Players")
local lp = Players.LocalPlayer
local ANIM_ID = "rbxassetid://86505219150915"

-- 1. BRIDGE SETUP
local function createBridge()
    local folder = lp:FindFirstChild("SyncBridge") or Instance.new("Folder", lp)
    folder.Name = "SyncBridge"
    local signal = folder:FindFirstChild("Trigger") or Instance.new("IntValue", folder)
    signal.Name = "Trigger"
    signal.Value = 0
end
createBridge()

-- 2. MODERN COMPACT GUI
local sg = Instance.new("ScreenGui", game:GetService("CoreGui"))
sg.Name = "NanoSwap"

local main = Instance.new("Frame", sg)
main.Size = UDim2.new(0, 200, 0, 220)
main.Position = UDim2.new(0.05, 0, 0.4, 0)
main.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
main.BorderSizePixel = 0
main.Active = true
main.Draggable = true
local corner = Instance.new("UICorner", main)
corner.CornerRadius = UDim.new(0, 10)

local title = Instance.new("TextLabel", main)
title.Size = UDim2.new(1, 0, 0, 30)
title.Text = "SELECT PLAYER"
title.TextColor3 = Color3.new(1, 1, 1)
title.Font = Enum.Font.GothamBold
title.TextSize = 12
title.BackgroundTransparency = 1

local scroll = Instance.new("ScrollingFrame", main)
scroll.Size = UDim2.new(1, -10, 1, -40)
scroll.Position = UDim2.new(0, 5, 0, 35)
scroll.BackgroundTransparency = 1
scroll.ScrollBarThickness = 0
local layout = Instance.new("UIListLayout", scroll)
layout.Padding = UDim.new(0, 5)

-- 3. THE CORE SWAP LOGIC
local target = nil

local function playAnimAndSwap()
    if not target or not target.Character or not lp.Character then return end
    
    local myRoot = lp.Character:FindFirstChild("HumanoidRootPart")
    local hisRoot = target.Character:FindFirstChild("HumanoidRootPart")
    local myHum = lp.Character:FindFirstChild("Humanoid")
    
    if myRoot and hisRoot and myHum then
        -- Load and Play Anim
        local anim = Instance.new("Animation")
        anim.AnimationId = ANIM_ID
        local load = myHum:LoadAnimation(anim)
        load:Play()
        
        -- Timing: Wait for the animation's "action point" before snapping
        -- Adjust this wait time to match when the animation looks best for a swap
        task.wait(0.6) 
        
        -- The Physical Swap
        myRoot.CFrame = hisRoot.CFrame
    end
end

-- Listen for his trigger
local function listen(partner)
    local bridge = partner:WaitForChild("SyncBridge", 10)
    if bridge then
        bridge.Trigger.Changed:Connect(function()
            playAnimAndSwap() -- He clicked, so we play anim and move
        end)
    end
end

-- 4. BUTTONS & UI TRANSITION
local function updateList()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= lp then
            local b = Instance.new("TextButton", scroll)
            b.Size = UDim2.new(1, 0, 0, 30)
            b.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
            b.Text = p.DisplayName
            b.TextColor3 = Color3.new(1, 1, 1)
            b.Font = Enum.Font.Gotham
            b.TextSize = 11
            Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)

            b.MouseButton1Click:Connect(function()
                target = p
                listen(p)
                
                -- SHRINK UI
                scroll.Visible = false
                main:TweenSize(UDim2.new(0, 120, 0, 60), "Out", "Quad", 0.3, true)
                title.Text = "READY: " .. p.Name:upper()
                title.TextSize = 8
                
                local sBtn = Instance.new("TextButton", main)
                sBtn.Size = UDim2.new(0.9, 0, 0, 25)
                sBtn.Position = UDim2.new(0.05, 0, 0.5, 0)
                sBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
                sBtn.Text = "SWAP"
                sBtn.Font = Enum.Font.GothamBold
                sBtn.TextColor3 = Color3.new(1, 1, 1)
                sBtn.TextSize = 12
                Instance.new("UICorner", sBtn)

                sBtn.MouseButton1Click:Connect(function()
                    -- Increment our value to signal his script
                    lp.SyncBridge.Trigger.Value = lp.SyncBridge.Trigger.Value + 1
                    -- Play for ourselves
                    playAnimAndSwap()
                end)
            end)
        end
    end
end

updateList()
