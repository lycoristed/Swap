local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local lp = Players.LocalPlayer

local TAG_NAME = "SyncActive_Token"
local REQUEST_TAG = "SwapRequest" 

-- 1. Setup Tags (This tells the other person you are ready)
local function setupTags(char)
    if not char then return end
    local tag = char:FindFirstChild(TAG_NAME) or Instance.new("StringValue")
    tag.Name = TAG_NAME
    tag.Parent = char
    
    local req = char:FindFirstChild(REQUEST_TAG) or Instance.new("StringValue")
    req.Name = REQUEST_TAG
    req.Value = ""
    req.Parent = char
end
setupTags(lp.Character or lp.CharacterAdded:Wait())
lp.CharacterAdded:Connect(setupTags)

-- 2. UI Creation
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "FinalSyncSwap"
screenGui.ResetOnSpawn = false
screenGui.Parent = CoreGui

local mainFrame = Instance.new("Frame")
mainFrame.Size = UDim2.new(0, 200, 0, 250)
mainFrame.Position = UDim2.new(0.1, 0, 0.4, 0)
mainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
mainFrame.Active = true
mainFrame.Draggable = true
mainFrame.Parent = screenGui
Instance.new("UICorner", mainFrame)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 30)
title.Text = "Waiting for Partner..."
title.TextColor3 = Color3.new(1, 1, 1)
title.BackgroundTransparency = 1
title.Parent = mainFrame

local scroll = Instance.new("ScrollingFrame")
scroll.Size = UDim2.new(1, -10, 1, -40)
scroll.Position = UDim2.new(0, 5, 0, 35)
scroll.BackgroundTransparency = 1
scroll.ScrollBarThickness = 4
scroll.Parent = mainFrame

local layout = Instance.new("UIListLayout", scroll)
layout.Padding = UDim.new(0, 5)

local swapBtn = Instance.new("TextButton")
swapBtn.Size = UDim2.new(1, -10, 1, -40)
swapBtn.Position = UDim2.new(0, 5, 0, 35)
swapBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 255)
swapBtn.Text = "SWAP"
swapBtn.Visible = false
swapBtn.Parent = mainFrame
Instance.new("UICorner", swapBtn)

-- 3. The Sync Logic
local targetPlayer = nil

local function moveMe()
    if targetPlayer and targetPlayer.Character and lp.Character then
        local myRoot = lp.Character:FindFirstChild("HumanoidRootPart")
        local hisRoot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
        if myRoot and hisRoot then
            myRoot.CFrame = hisRoot.CFrame
        end
    end
end

-- This watches HIS character for the "Trigger" signal
local function listenForPartner(partner)
    partner.CharacterAdded:Connect(function(char)
        local req = char:WaitForChild(REQUEST_TAG, 10)
        if req then
            req.Changed:Connect(function(val)
                if val == "Trigger" then moveMe() end
            end)
        end
    end)
    -- Initial check
    local req = partner.Character and partner.Character:FindFirstChild(REQUEST_TAG)
    if req then
        req.Changed:Connect(function(val)
            if val == "Trigger" then moveMe() end
        end)
    end
end

-- When YOU click
swapBtn.MouseButton1Click:Connect(function()
    local myReq = lp.Character and lp.Character:FindFirstChild(REQUEST_TAG)
    if myReq then
        moveMe() -- Move yourself
        myReq.Value = "Trigger" -- Signal him to move
        task.wait(0.2)
        myReq.Value = "" -- Reset
    end
end)

-- Update List
local function updateList()
    for _, v in pairs(scroll:GetChildren()) do if v:IsA("TextButton") then v:Destroy() end end
    
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= lp and p.Character and p.Character:FindFirstChild(TAG_NAME) then
            title.Text = "User Detected!"
            local btn = Instance.new("TextButton", scroll)
            btn.Size = UDim2.new(1, -5, 0, 35)
            btn.Text = p.DisplayName
            btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
            btn.TextColor3 = Color3.new(1, 1, 1)
            Instance.new("UICorner", btn)
            
            btn.MouseButton1Click:Connect(function()
                targetPlayer = p
                listenForPartner(p)
                scroll.Visible = false
                swapBtn.Visible = true
                mainFrame.Size = UDim2.new(0, 100, 0, 80)
                title.Text = "Linked"
            end)
        end
    end
    scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y)
end

-- Refresh frequently
task.spawn(function()
    while task.wait(1) do 
        if scroll.Visible then updateList() end 
    end
end)
